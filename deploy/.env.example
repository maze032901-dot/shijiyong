# The host name of a domain you own. Its A record must point to the server first.
HERMES_DOMAIN=cards.example.com

# Create a random 32-byte-or-longer value. This is entered into the paired Android app.
HERMES_INTAKE_TOKEN=replace-with-a-long-random-secret

# Separate secrets for the mobile card library. Never reuse HERMES_INTAKE_TOKEN.
# The first is entered only in Android; the second is shared only by cloud and Mac.
HERMES_MOBILE_TOKEN=replace-with-a-different-64-character-random-token
HERMES_MOBILE_PUBLISH_TOKEN=replace-with-a-third-64-character-random-token

# These protect the web dashboard and all saved media. The password is a Caddy hash,
# never a plaintext password. Generate it with Caddy's interactive hash-password
# command, then surround the resulting hash with single quotes in .env so
# Docker Compose does not interpolate the dollar signs in a bcrypt hash.
HERMES_DASHBOARD_USER=owner
HERMES_DASHBOARD_PASSWORD_HASH=replace-with-caddy-password-hash
